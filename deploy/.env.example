# Env file for the self-hosted docker-compose.yml stack (docs/SELF_HOSTING.md).
# Copy to the repo root as .env (docker compose reads .env from alongside
# docker-compose.yml, not from this deploy/ directory) and fill in real
# values -- never commit that .env:
#   cp deploy/.env.example .env
#
# Generate every secret/password below with:
#   openssl rand -hex 32
# Hex-only output deliberately avoids quote characters, since
# deploy/postgres/init-roles.sh embeds these passwords in a single-quoted
# SQL string.

# The public hostname this deploys to -- must exactly match the tunnel's
# Published application route (Cloudflare Zero Trust dashboard). The
# route created so far is for www.reelgoodday.com, not the bare apex
# domain, so that's what belongs here unless/until a second route for
# the apex is added too.
DOMAIN=www.reelgoodday.com

# Postgres: one superuser bootstrap password, plus one password per
# least-privilege app role (ADR-006's auth/forecast schema split).
POSTGRES_SUPERUSER_PASSWORD=
SALTLINE_WEB_DB_PASSWORD=
SALTLINE_API_DB_PASSWORD=

# Shared secret that signs internal apps/web -> apps/api requests.
# Same value in both containers; docker-compose.yml wires that up.
INTERNAL_SIGNING_KEY_ID=default
INTERNAL_SIGNING_KEY_SECRET=

# Better Auth's session/cookie signing secret.
BETTER_AUTH_SECRET=

# Optional SMTP -- unset means accounts auto-confirm and no emails send
# (same convention the legacy app used), which is fine to start with.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# No Cloudflare Tunnel token here: cloudflared runs natively on the host
# (not as a container), pointed at this stack's published localhost:3000.
# See docs/SELF_HOSTING.md.
